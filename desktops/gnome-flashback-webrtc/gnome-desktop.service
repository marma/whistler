[Unit]
Description=GNOME Flashback Desktop Session over WebRTC (Selkies)
Documentation=https://github.com/marma/whistler
After=dbus.service systemd-logind.service
Requires=dbus.service

[Service]
# User=root (unlike xfce-webrtc/gnome-grd's unprivileged desktop user) — see
# the Dockerfile header. Ubuntu 26.04's GTK stack routes every image load
# (icons included) through glycin's bwrap sandbox, which needs an unprivileged
# user+network namespace; this host's kernel.apparmor_restrict_unprivileged_
# userns=1 blocks that for non-root callers even in a privileged container,
# which makes metacity/gnome-panel/gnome-flashback abort the instant they try
# to load an icon. Real root bypasses that specific AppArmor check, which is
# what makes the session usable at all. We're already inside a systemd-PID1 /
# privileged (Kata-isolated in prod) container, so this isn't a new trust
# boundary — just a different uid inside one that already has full access.
#
# PAMName=login tells systemd to open a full PAM session (session management
# only, no password prompt). pam_systemd then calls logind CreateSession,
# which registers a real login1 user and starts user@UID.service (systemd
# --user) — gnome-session's own systemd-unit-based startup sequence (see
# Dockerfile header) hard-requires that to exist.
User=root
PAMName=login
Environment=XDG_SESSION_TYPE=x11
Environment=XDG_SESSION_CLASS=user
PassEnvironment=SELKIES_PORT SELKIES_RESOLUTION SELKIES_FRAMERATE SELKIES_VIDEO_BITRATE SELKIES_USE_INTERNAL_TURN SELKIES_TURN_SHARED_SECRET INTERNAL_TURN_PORT INTERNAL_TURN_MIN_PORT INTERNAL_TURN_MAX_PORT INTERNAL_TURN_EXTERNAL_IP SELKIES_TURN_HOST SELKIES_TURN_PORT SELKIES_TURN_PROTOCOL
ExecStart=/usr/local/bin/session.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
