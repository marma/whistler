#cloud-config
# Bake-time cloud-config (NOT the per-session userData — that comes from
# whistler/cloudinit.py). build.sh serves this over NoCloud-net (qemu SMBIOS
# serial points cloud-init at http://10.0.2.2:@HTTP_PORT@/) for a one-shot
# boot that installs the desktop + streamer stack, then resets cloud-init so
# the published image treats every session's seed as a fresh first boot.
#
# users: [] — do NOT create the image's default `ubuntu` user. The session
# userData suppresses the default user to keep uid 1000 free for the real
# Whistler user (see whistler/cloudinit.py); a bake that let cloud-init create
# `ubuntu` would permanently occupy uid 1000 in the published image.
users: []

write_files:
  - path: /run/whistler-bake.sh
    permissions: "0755"
    content: |
      #!/bin/sh
      # The actual bake. /run is tmpfs, so this script never ships.
      set -eux
      export DEBIAN_FRONTEND=noninteractive
      SEED=http://10.0.2.2:@HTTP_PORT@

      # The bake races the boot's own apt jobs (apt-news, esm-cache,
      # apt-daily): the lock timeout waits them out instead of dying, and the
      # retry absorbs transient mirror hiccups — an `update` failure here
      # killed a whole bake once, mid-lists-store, with nothing else wrong.
      APT="apt-get -o DPkg::Lock::Timeout=120"
      i=0
      until $APT update; do
        i=$((i + 1)); [ "$i" -ge 3 ] && exit 1
        sleep 15
      done
      # The runtime union of desktops/xfce-plain and desktops/streamer-selkies2
      # (see those Dockerfiles for the why of every package — the silent
      # failure modes are documented there and in design/creating_desktops.md
      # §4-5). Build-time-only packages (build-essential, python3-dev,
      # libxkbcommon-dev) are NOT needed: the selkies venv arrives prebuilt in
      # artifacts.tar.gz; libxkbcommon0 is its one runtime shared lib.
      # x11-apps is here for `xwd` alone (it is NOT in x11-utils): the portal
      # SSHes in periodically and grabs the display for the session thumbnail
      # — see whistler/portal/screenshots.py.
      # ubuntu-wallpapers ships the release's wallpaper set *and* the
      # release-independent default aliases the xfconf backdrop default points
      # at (guest/ etc/xdg/.../xfce4-desktop.xml). Nothing in xfce4 pulls it
      # in — without it the desktop is the stock Xfce mouse.
      # yaru-theme-icon is Ubuntu's icon set, selected by the xsettings default
      # next to it (guest/ etc/xdg/.../xsettings.xml) and equally not pulled in
      # by anything. That override *replaces* a conffile xfce4-settings ships
      # here — hence the artifacts.tar.gz extraction below must stay after this
      # install, or dpkg's own file (IconThemeName=elementary-xfce-dark, a
      # theme no Recommends brings in) is what the session reads.
      # xfce4 depends on adwaita-icon-theme, which stays as the
      # fallback for icons Yaru doesn't define (Yaru inherits Humanity/hicolor,
      # never Adwaita — but GTK appends Adwaita to every lookup chain anyway).
      $APT install -y --no-install-recommends \
        xfce4 xfce4-terminal dbus-x11 \
        ubuntu-wallpapers yaru-theme-icon \
        xvfb x11-xserver-utils xcvt x11-utils xclip xdotool \
        x11-apps \
        pulseaudio pulseaudio-utils \
        python3 python3-venv libxkbcommon0 \
        ssl-cert ca-certificates curl \
        rclone fuse3 \
        nfs-common

      # NVIDIA driver for KubeVirt GPU-passthrough sessions (vfio-pci hands
      # the guest a raw PCI device — same as bare metal, there is no
      # host-driver-injection path for VMs the way there is for pod-mode GPU
      # containers, so the guest needs its own real driver). Only present in
      # the CUDA variant (build.sh CUDA=1 sets NVIDIA_DRIVER_PACKAGE and tags
      # :<TAG>-cuda; the lean default leaves it empty and skips this block).
      # Baked at image-build time, not installed by the per-session cloud-init:
      # the default zone's egress blocks package mirrors, so a GPU session boots
      # ready instead of installing a driver on first connect.
      if [ -n "@NVIDIA_DRIVER_PACKAGE@" ]; then
        $APT install -y --no-install-recommends "@NVIDIA_DRIVER_PACKAGE@"
      fi

      # CUDA SDK — OFF by default, and deliberately so. The image ships the
      # *runtime* only: the driver above already provides libcuda.so.1, the PTX
      # JIT, libnvoptix + rtcore (Blender's OptiX backend) and libnvidia-encode,
      # which is everything GPU workloads actually load. PyTorch wheels carry
      # their own cudart/cuBLAS/cuDNN/nvrtc; Blender ships precompiled Cycles
      # kernels. nvidia-cuda-toolkit adds a couple of GB of *build*-time SDK on
      # top of that — nearly all of it nvidia-cuda-dev headers and static libs,
      # plus g++ as nvcc's mandatory host compiler — which only matters when
      # someone compiles CUDA C++ in-guest. That belongs in a dev/data-science
      # desktop, or in the user's $HOME via a user-space package manager
      # (pixi/conda-forge ship cuda-nvcc and compilers without root) — not in
      # every GPU session. Set CUDA_TOOLKIT_PACKAGE=nvidia-cuda-toolkit to bake
      # it in anyway; --no-install-recommends then still excludes the ~1.6GB of
      # nsight / visual-profiler tooling (the profiler is what used to drag in
      # openjdk-8-jre + GTK2).
      if [ -n "@CUDA_TOOLKIT_PACKAGE@" ]; then
        $APT install -y --no-install-recommends "@CUDA_TOOLKIT_PACKAGE@"
      fi

      # Selkies venv + web client (extracted from the streamer-selkies2 docker
      # build — same pinned SELKIES_COMMIT, client/server lock preserved) plus
      # the whistler-streamer / whistler-desktop@ units and scripts (guest/).
      # --no-overwrite-dir: never restore the archive's metadata onto existing
      # system dirs (/etc, /usr, ...) — a group-writable /etc from the build
      # host's umask breaks sshd StrictModes for /etc/ssh/authorized_keys.d.
      curl -fsS "$SEED/artifacts.tar.gz" | tar -xz --no-overwrite-dir -C /
      chmod 0755 /usr/local/bin/whistler-streamer \
                 /usr/local/bin/whistler-desktop-session \
                 /usr/local/bin/wtype

      # The xfconf defaults that just landed name a wallpaper by path and an
      # icon theme by name, and nothing validates either at session start: a
      # missing picture just leaves xfdesktop on its built-in Xfce backdrop, an
      # icon theme that isn't installed just leaves GTK on Adwaita — both
      # silently. Assert them here so a renamed wallpaper or a dropped theme
      # package fails the bake instead.
      test -f /usr/share/backgrounds/warty-final-ubuntu.png
      test -d /usr/share/icons/Yaru

      # The streamer has no per-session inputs (its env file is optional), so
      # it is enabled at bake; the per-user whistler-desktop@<user> unit is
      # enabled by the session's cloud-init once the user exists.
      systemctl enable whistler-streamer.service

      # Session boots must be fast: snapd.seeded alone holds multi-user.target
      # (and with it cloud-init's runcmd stage) for ~30s on stock images —
      # measured, see whistler/cloudinit.py. No snaps are used; purge it.
      $APT purge -y snapd unattended-upgrades || true
      $APT autoremove -y --purge
      apt-get clean
      rm -rf /var/lib/apt/lists/*

      # Reset so the published image runs the per-session seed as a true
      # first boot: instance state gone, logs gone, machine-id regenerates.
      cloud-init clean --logs --machine-id
      # Return freed blocks so the compressed qcow2 doesn't carry them.
      fstrim -av || true

runcmd:
  # One wrapper, not a list of runcmd items: runcmd does not stop on failure,
  # so the bake runs under its own `set -e` and reports a single verdict on
  # the serial console for build.sh to grep. Output lands in a persistent log
  # (live-tailed to ttyS0 for console.log; getty escape codes once ATE the
  # only copy of an apt error, hence the file) whose tail is replayed on FAIL.
  - [sh, -c, "tail -F /var/log/whistler-bake.log >/dev/ttyS0 2>/dev/null & sh /run/whistler-bake.sh >/var/log/whistler-bake.log 2>&1 && echo WHISTLER-BAKE-OK >/dev/ttyS0 || { echo WHISTLER-BAKE-FAIL >/dev/ttyS0; tail -40 /var/log/whistler-bake.log >/dev/ttyS0; }; shutdown -P now"]
