                 elif self.mouse: self.mouse.release(btn_uinput_or_pynput)
 
+    def _whistler_resolve_keycode(self, keysym):
+        """Find (keycode, level 0-3) for keysym via a LIVE protocol query
+        (get_keyboard_mapping, not the cached keycode_to_keysym/
+        keysym_to_keycode convenience methods - self.xdisplay is a
+        long-lived connection whose cache does NOT track GNOME's live
+        keymap reconciliation; confirmed directly, a fresh connection found
+        colon at keycode 60/level 1 while self.xdisplay's cache didn't).
+        Prefers the lowest level (0=base,1=shift,2=altgr,3=shift+altgr -
+        the X11 core-protocol convention; this server flattens multiple
+        XKB groups into one wide per-keycode list, so level = index % 4).
+        """
+        if not self.xdisplay:
+            return None, 0
+        try:
+            min_kc = self.xdisplay.display.info.min_keycode
+            max_kc = self.xdisplay.display.info.max_keycode
+            raw = self.xdisplay.get_keyboard_mapping(min_kc, max_kc - min_kc + 1)
+        except Exception:
+            return None, 0
+        # WHISTLER-DEBUG fix, take 6: idx % 4 is only a valid "level" when idx
+        # is actually IN group 0 (idx < 4) - this server flattens multiple XKB
+        # groups into one wide per-keycode list, and idx >= 4 belongs to a
+        # DIFFERENT group entirely, not "the same level in group 0". Confirmed
+        # directly: keycode 53 is "x X x X guillemetright greater x X" -
+        # "greater" sits at idx=5 (group 1), and idx=5 % 4 == 1 was wrongly
+        # treated as "just needs Shift", so pressing keycode 53 + Shift
+        # delivered group 0's REAL level 1 there ('X') instead - reproducing
+        # the exact ">" corruption. "less"/"greater" are ALSO natively in
+        # group 0 (keycode 94), so strictly preferring idx < 4 matches finds
+        # that instead; idx >= 4 is only used as a last-resort fallback (still
+        # group-ambiguous, but better than never matching at all).
+        best = None       # best idx<4 (group-0-safe) match: (keycode, level)
+        fallback = None   # best idx>=4 match, only used if no idx<4 exists
+        for offset, syms in enumerate(raw):
+            kc = min_kc + offset
+            for idx, ks in enumerate(syms):
+                if not ks or ks != keysym:
+                    continue
+                level = idx % 4
+                if idx < 4:
+                    if best is None or level < best[1]:
+                        best = (kc, level)
+                    if level == 0:
+                        return kc, 0
+                elif fallback is None:
+                    fallback = (kc, level)
+        if best is not None:
+            return best
+        if fallback is not None:
+            return fallback
+        return None, 0
+
+    def _whistler_alloc_scratch_keycode(self):
+        """Find (and cache) an unused keycode to remap on demand. Discovered
+        once per xdisplay connection via a live keymap query (NoSymbol on
+        every group/level), not hardcoded - the exact free keycodes are
+        keymap-layout-dependent."""
+        if not hasattr(self, '_whistler_scratch_pool'):
+            pool = []
+            try:
+                min_kc = self.xdisplay.display.info.min_keycode
+                max_kc = self.xdisplay.display.info.max_keycode
+                raw = self.xdisplay.get_keyboard_mapping(min_kc, max_kc - min_kc + 1)
+                for offset, syms in enumerate(raw):
+                    if not any(syms):
+                        pool.append(min_kc + offset)
+            except Exception:
+                pool = []
+            self._whistler_scratch_pool = pool
+            self._whistler_scratch_inuse = {}
+        return self._whistler_scratch_pool
+
+    async def _whistler_remap_inject(self, keysym, down):
+        """Inject one keysym by temporarily remapping an unused ("scratch")
+        keycode to it and pressing that keycode bare, with no modifiers at
+        all - then restoring the keycode to NoSymbol on release.
+
+        WHISTLER-DEBUG fix, take 7: level>=2 (AltGr-involving) characters
+        kept misrendering even with exactly-correct Shift+AltGr state
+        synthesized (confirmed via a receiver: keycode 15 pressed with
+        state=0x81 - genuinely Shift+Mod5/AltGr held, verified via
+        XQueryKeymap - still delivered "radical" instead of "asciicircum",
+        and keycode 51 delivered "multiply" instead of "bar"). Root cause:
+        GetKeyboardMapping's flat per-keycode index does not reliably mean
+        "index 2 = AltGr, index 3 = Shift+AltGr" - that mapping is actually
+        governed by the key's XKB "type" definition, which for two-groups
+        Swedish/US mixed layouts is not always the textbook FOUR_LEVEL type
+        the index%4 arithmetic assumes. There is no way to reverse-engineer
+        that from GetKeyboardMapping alone (it is a core-protocol
+        compatibility flattening, not the real XKB type table). Remapping a
+        scratch keycode sidesteps the whole problem: with no modifiers
+        involved, only "index 0" (unambiguous across every key type) is
+        ever used. Confirmed directly - same repro that previously produced
+        "√|" instead of "^|" now produces exactly the right bytes.
+
+        Scoped to level>=2 (AltGr) cases only, where this ambiguity has
+        actually been observed - level 0/1 injection via the plain
+        Shift-synthesis path in _whistler_xtest_inject is unaffected (types
+        for the no-AltGr levels have always resolved correctly here) and
+        remapping on every keystroke would add an X MappingNotify broadcast
+        (all clients recompute their keymap cache) that's better avoided
+        for the common case.
+        """
+        if not (self.xdisplay and xtest):
+            return False
+        if not hasattr(self, '_whistler_remap_lock'):
+            self._whistler_remap_lock = asyncio.Lock()
+        if down:
+            pool = self._whistler_alloc_scratch_keycode()
+            kc = next((c for c in pool if c not in self._whistler_scratch_inuse.values()), None)
+            if kc is None:
+                return False
+            async with self._whistler_remap_lock:
+                self.xdisplay.change_keyboard_mapping(kc, [(keysym, keysym, keysym, keysym)])
+                self.xdisplay.sync()
+                xtest.fake_input(self.xdisplay, X.KeyPress, kc)
+                self.xdisplay.sync()
+            self._whistler_scratch_inuse[keysym] = kc
+        else:
+            kc = self._whistler_scratch_inuse.pop(keysym, None)
+            if kc is None:
+                return False
+            xtest.fake_input(self.xdisplay, X.KeyRelease, kc)
+            self.xdisplay.sync()
+            async with self._whistler_remap_lock:
+                self.xdisplay.change_keyboard_mapping(kc, [(0, 0, 0, 0)])
+                self.xdisplay.sync()
+        logger_webrtc_input.debug(
+            f"WHISTLER-DEBUG remap-inject keysym={keysym:#x} down={down} scratch_kc={kc}"
+        )
+        return True
+
+    async def _whistler_xtest_inject(self, keysym, down):
+        """Inject one keysym via direct XTEST, bypassing xdotool's own
+        keycode/modifier resolution AND its own modifier bookkeeping
+        entirely (which reproducibly left AltGr stuck held - confirmed via
+        XQueryKeymap after a single ">" corrupted the next keystroke).
+        For level>=2 (AltGr-involving) keysyms, delegates to
+        _whistler_remap_inject instead of trying to synthesize Shift/AltGr -
+        see that method's docstring for why. For level 0/1, explicitly
+        synthesizes Shift only if needed and isn't already genuinely held,
+        tracked per-keysym so the matching keyup releases exactly what this
+        keydown pressed - keydown and keyup arrive as separate calls, so
+        state has to survive between them (unlike the co,end path, which
+        calls both back-to-back)."""
+        if not (self.xdisplay and xtest):
+            return False
+        kc, level = self._whistler_resolve_keycode(keysym)
+        if not kc or level >= 2:
+            return await self._whistler_remap_inject(keysym, down)
+        if not hasattr(self, '_whistler_synth_mods'):
+            self._whistler_synth_mods = {}
+        if down:
+            synthesized = []
+            if level & 1 and not ({65505, 65506} & self.active_modifiers):
+                shift_kc, _ = self._whistler_resolve_keycode(0xffe1)  # Shift_L
+                if shift_kc:
+                    xtest.fake_input(self.xdisplay, X.KeyPress, shift_kc)
+                    synthesized.append(shift_kc)
+            self._whistler_synth_mods[keysym] = synthesized
+            xtest.fake_input(self.xdisplay, X.KeyPress, kc)
+        else:
+            xtest.fake_input(self.xdisplay, X.KeyRelease, kc)
+            for mod_kc in reversed(self._whistler_synth_mods.pop(keysym, [])):
+                xtest.fake_input(self.xdisplay, X.KeyRelease, mod_kc)
+        self.xdisplay.sync()
+        logger_webrtc_input.debug(
+            f"WHISTLER-DEBUG XTEST-direct keysym={keysym:#x} down={down} "
+            f"keycode={kc} level={level}"
+        )
+        return True
+
