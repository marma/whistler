# Base RDP image for Whistler desktops — Ubuntu 26.04 LTS, multi-arch (amd64 +
# arm64). This carries *only* the xrdp/xorgxrdp display plumbing and the
# well-known desktop login; it ships **no desktop environment** and is not meant
# to be run directly. Desktop catalog entries build `FROM` this image, install a
# DE, and point xrdp at it via WHISTLER_SESSION_CMD (see ../README.md).
#
# guacd connects on 3389 with the well-known creds below (security=any,
# ignore-cert=true). Transport safety comes from the per-session NetworkPolicy,
# not the password — see design/vdi.md.
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

# xrdp + xorgxrdp are the RDP listener and the Xorg backend module; dbus-x11
# provides dbus-launch (DEs need a session bus) and x11-xserver-utils provides
# xrefresh/xset etc. that most DEs expect to exist.
RUN apt-get update && apt-get install -y --no-install-recommends \
      xrdp \
      xorgxrdp \
      dbus-x11 \
      x11-xserver-utils \
 && rm -rf /var/lib/apt/lists/*

# Well-known desktop login. Override at build time for other catalog entries;
# keep in sync with the DesktopTemplate's connectionParams.
ARG DESKTOP_USER=abc
ARG DESKTOP_PASSWORD=abc

RUN useradd -m -s /bin/bash "${DESKTOP_USER}" \
 && echo "${DESKTOP_USER}:${DESKTOP_PASSWORD}" | chpasswd \
 # xrdp needs to read its TLS key (generated by the package postinst).
 && adduser xrdp ssl-cert

# xrdp config: 24-bit session (no RemoteFX/GFX) so guacd gets lossless bitmaps,
# and console logging so the negotiated codec shows up in `kubectl logs`.
COPY xrdp.ini /etc/xrdp/xrdp.ini
# startwm.sh sets up the session D-Bus + XDG_RUNTIME_DIR, then launches whatever
# WHISTLER_SESSION_CMD a derived image sets.
COPY startwm.sh /etc/xrdp/startwm.sh
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /etc/xrdp/startwm.sh /entrypoint.sh

EXPOSE 3389
ENTRYPOINT ["/entrypoint.sh"]
