[Unit]
Description=GNOME Headless Desktop Session (gnome-remote-desktop)
Documentation=https://github.com/marma/whistler
After=dbus.service systemd-logind.service
Requires=dbus.service

[Service]
# PAMName=login tells systemd to open a full PAM session (session management
# only, no password prompt). pam_systemd then calls logind CreateSession, which
# gives gnome-shell a real login1 user and starts user@UID.service (systemd
# --user), which provides the session D-Bus and socket-activates pipewire.
User=abc
PAMName=login
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
PassEnvironment=DESKTOP_USER DESKTOP_PASSWORD WHISTLER_RESOLUTION
ExecStart=/usr/local/bin/session.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
