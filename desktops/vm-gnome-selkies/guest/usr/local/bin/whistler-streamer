#!/usr/bin/env bash
# Display plane of a Whistler VM desktop: X server + audio daemon + Selkies
# 2.0 streamer, run as a system service (whistler-streamer.service). The DE
# session (whistler-desktop@.service) lives in the same guest and finds the X
# and Pulse sockets by path; dbus is the VM's own (the unit orders
# After=dbus.service).
#
# Config comes from /etc/whistler/streamer.env (EnvironmentFile in the unit),
# written per-session by cloud-init from the template's streamerEnv and
# displayPort. Selkies 2.0 reads every setting from SELKIES_<NAME> itself
# (`--my-setting` <-> SELKIES_MY_SETTING, CLI winning over env), so a template
# can set any Selkies setting through streamerEnv without this script naming
# it — SELKIES_ENCODER=h265enc, SELKIES_MODE=webrtc, ... The settings
# reference is https://docs.selkies.io/settings.
#
# libva note: pixelflux links the system libva and needs vaMapBuffer2
# (libva >= 2.21). 24.04 ships 2.20, so the bake drops a vendored libva 2.22
# into /usr/local/lib and runs ldconfig — that copy wins here. If the stream
# dies with "Legacy screen_capture_module.so not found" on connect, the
# vendored libva didn't take (check `ldconfig -p | grep libva`).
set -e

export PATH=/opt/venv/bin:$PATH
export DISPLAY="${DISPLAY:-:0}"

SELKIES_PORT="${SELKIES_PORT:-8082}"
RES="${SELKIES_RESOLUTION:-1280x720}"

# Headless PulseAudio with a null sink; pcmflux captures the sink's monitor.
# The DE session reaches the same daemon via PULSE_SERVER, so its playback is
# what gets streamed. auth-anonymous because the guest is the trust boundary.
export PULSE_SERVER="unix:/tmp/pulse/native"
# Clear runtime state left by a previous run (a persistent-root/CDI guest
# reboots into the same disk): a stale pid file makes the daemon refuse to
# start and silently kills audio; a stale X lock or socket makes Xvfb exit
# immediately.
rm -rf /root/.config/pulse /tmp/pulse-* /tmp/pulse/* /tmp/.X*-lock /tmp/.X11-unix/X*
mkdir -p /tmp/pulse && chmod 777 /tmp/pulse
# The sink is named `output` because Selkies captures `output.monitor` by
# default (--audio-device-name).
pulseaudio --daemonize=false --realtime=false --disallow-exit --exit-idle-time=-1 \
  --load="module-native-protocol-unix auth-anonymous=1 socket=/tmp/pulse/native" \
  --load="module-null-sink sink_name=output sink_properties=device.description=output" \
  --log-target=stderr &
for i in $(seq 1 30); do [ -S /tmp/pulse/native ] && break; sleep 0.2; done
pactl set-default-source output.monitor 2>/dev/null || \
  echo "[whistler-streamer] warning: could not set default pulse source (audio may not work)"

# Open up the X socket dir so the (differently-uid'd) desktop user's clients
# can reach the socket Xvfb drops in it. Sticky like a real X11 dir.
mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# No GPU answers here: test.sh's qemu, a lean image, or a -cuda session started
# with No GPU (an ordinary choice since the GPU-type picker learned to say so).
# Two consequences, both scoped to this process tree.
#
# 1. On the CUDA image nvidia-smi must look ABSENT, not broken: with the
#    driver installed but no card it prints its failure on STDOUT and exits 9.
#    Selkies 1.x fed that to GPUtil, whose ValueError killed every data
#    WebSocket before a frame (the session reload-looped at ~6s while the
#    portal called it Ready). 2.0 dropped GPUtil and checks the exit status,
#    so this is now belt and braces: the silent, non-zero shim in
#    /usr/local/lib/whistler/no-gpu goes on PATH ahead of the real one, so
#    nothing in the streamer's tree can parse that sentence as data.
# 2. The CUDA image ships the NVIDIA EGL ICD (glvnd vendor file), and glvnd
#    probing that ICD with no device segfaults Xvfb inside its GLX init (crash
#    in InitExtensions via libEGL) — the streamer then "runs" with Selkies
#    serving but no X, and the desktop unit loops on "no X server on :0". Pin
#    EGL to the Mesa ICD instead: Xvfb's GLX is Mesa swrast either way, so GPU
#    sessions (where nvidia-smi succeeds and this whole branch is skipped) lose
#    nothing, and on a lean image Mesa is already the only vendor — a no-op.
if ! nvidia-smi -L >/dev/null 2>&1; then
  export PATH=/usr/local/lib/whistler/no-gpu:$PATH
  if [ -e /usr/share/glvnd/egl_vendor.d/50_mesa.json ]; then
    export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
  fi
fi

# Headless X server (software framebuffer) that pixelflux captures — the
# virtio-gpu/VNC console framebuffer is NOT used for the desktop; it keeps
# showing the text console (and stays reachable as a rescue path via the
# KubeVirt VNC subresource). Started at the RandR ceiling, not at RES: Xvfb
# bakes its *maximum* size in from this `-screen` argument, so starting at RES
# would permanently cap dynamic resize. Shrink to RES below. `-ac` (no access
# control) is fine: only guest processes can reach the socket. +extension GLX
# so mutter/GNOME Shell can get a (software, llvmpipe) GL context.
XVFB_MAX_RES="7680x4320"
Xvfb "${DISPLAY}" -screen 0 "${XVFB_MAX_RES}x24" -ac +extension RANDR +extension GLX &
for i in $(seq 1 30); do xdpyinfo -display "${DISPLAY}" >/dev/null 2>&1 && break; sleep 0.2; done
# Shrink to RES in the background: a just-started Xvfb rejects RandR mode adds
# for its first ~15-20s, and retrying inline would stall startup (and with it
# the port the portal probes) for that long.
( for attempt in $(seq 1 60); do
    selkies-resize "${RES}" >/dev/null 2>&1 && break
    sleep 1
  done & )

# App-aware copy/paste for macOS clients: grabs the XF86Copy/XF86Paste taps
# the Mac web client sends for plain Cmd-C/Cmd-V (see
# bake/mac-cmd-chords.patch) and re-injects Ctrl+C/V or Ctrl+Shift+C/V
# depending on the focused window. Also pre-binds the Mode_switch /
# ISO_Level3_Shift keysyms Mac's Option-key remap uses (Option+7 for "|" on
# sv, etc.), which no modern layout binds. Supervised loop: the agent is
# stateless, so a crash just restarts it. `|| true` is load-bearing: this
# subshell inherits `set -e`, so without it the first non-zero exit (e.g. the
# agent racing an X server restart) ended the loop and the agent stayed dead.
( while true; do
    /usr/local/bin/whistler-copy-agent || true
    sleep 2
  done & )

# Selkies 2.0: pixelflux capture of $DISPLAY, encode, web client + WebSocket
# streaming on one port. Booleans take =true/=false; an unknown flag is
# ignored with an "Ignoring unrecognized argument" warning, so check the log
# after renaming one. Basic auth is ON by default (and refuses to start
# without a password) — off here explicitly; the per-session NetworkPolicy on
# the launcher pod is the security boundary.
#
# Encoder: the default is h264enc, and 2.0 picks the implementation itself —
# NVENC (the -cuda image's driver brings libnvidia-encode), then VA-API, then
# software x264 — and steps a browser that cannot decode the codec down a
# ladder ending in JPEG. Capture (Xvfb) and GNOME's rendering (llvmpipe) stay
# on the CPU regardless; only the encode moves to the GPU. The session log
# says which path each display took (the capture/encoder line at INFO). A
# template can choose another codec with SELKIES_ENCODER in streamerEnv.
#
# Video streaming mode ("Turbo": encode every frame) must be ON for GNOME.
# mutter is a GL compositor: once it composits a static window it emits no
# further damage, so damage-based capture leaves static windows BLACK until
# something forces a repaint. 2.0 defaults it on; it is passed explicitly so a
# changed upstream default cannot bring the bug back. It was called
# --h264-streaming-mode before 2.0, and templates still carrying
# SELKIES_H264_STREAMING_MODE in streamerEnv are honoured.
exec selkies \
  --addr=0.0.0.0 \
  --port="${SELKIES_PORT}" \
  --video-streaming-mode="${SELKIES_VIDEO_STREAMING_MODE:-${SELKIES_H264_STREAMING_MODE:-true}}" \
  --enable-basic-auth=false
