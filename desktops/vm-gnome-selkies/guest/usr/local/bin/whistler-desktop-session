#!/usr/bin/env bash
# GNOME Shell session for a Whistler VM desktop, run as the session user by
# whistler-desktop@<user>.service. The in-guest analog of the retired
# gnome-selkies2/entrypoint.sh session-launch tail: render the real GNOME Shell
# to a display somebody else owns (whistler-streamer.service here, the streamer
# sidecar in the pod model). Identity/user creation is cloud-init's job — this
# script only waits for the plumbing and launches the session.
#
# The session ENV (GSK_RENDERER, LIBGL_ALWAYS_SOFTWARE, XDG_*, GDK_BACKEND, ...)
# and XDG_RUNTIME_DIR come from the unit (Environment= / RuntimeDirectory=).
# Unlike the container images this does NOT hide systemd from gnome-shell — the
# VM's logind is alive and answers, so the Shell runs against it directly (see
# the logind note in whistler-desktop@.service).
set -e

export DISPLAY="${DISPLAY:-:0}"
export PULSE_SERVER="${PULSE_SERVER:-unix:/tmp/pulse/native}"

# Wait for the streamer's X. Unit ordering (After=whistler-streamer.service)
# only guarantees the service *started*, not that Xvfb finished coming up, so
# keep the wait-and-fail-loudly guard; Restart=always turns a genuinely dead
# display plane into a visible restart loop instead of a silent black screen.
for i in $(seq 1 120); do
  xdpyinfo -display "${DISPLAY}" >/dev/null 2>&1 && break
  [ "$i" = 1 ] && echo "[whistler-desktop] waiting for X display ${DISPLAY}..."
  sleep 0.5
done
if ! xdpyinfo -display "${DISPLAY}" >/dev/null 2>&1; then
  echo "[whistler-desktop] ERROR: no X server on DISPLAY=${DISPLAY} after 60s" >&2
  echo "[whistler-desktop] (is whistler-streamer.service running?)" >&2
  exit 1
fi

# Wait for the network home (the NFS mount cloud-init sets up) before starting
# the session: GNOME writes per-user state ($HOME/.config, dconf, keyring)
# immediately, and anything written to the pre-mount root-owned mountpoint would
# be shadowed the moment the share lands (same reasoning as the getty respawn in
# whistler/cloudinit.py). Proceed after the timeout anyway — a broken-home
# desktop that renders is more debuggable than a service that never starts.
if ! mountpoint -q "$HOME"; then
  echo "[whistler-desktop] waiting for $HOME to be mounted..."
  for i in $(seq 1 90); do
    mountpoint -q "$HOME" && break
    sleep 1
  done
  mountpoint -q "$HOME" || \
    echo "[whistler-desktop] WARNING: $HOME never mounted; starting anyway" >&2
fi

# cd only now (the unit deliberately has no WorkingDirectory: pre-mount the
# home is a root-owned 0700 mountpoint and chdir at spawn would kill the unit
# with status=200/CHDIR). If the home never mounted, / is an honest cwd.
cd "$HOME" 2>/dev/null || cd /

# dbus-run-session gives the session its own bus (no systemd --user: this is a
# system service with User=, and the unit's /run/systemd shadow makes gnome
# take its non-systemd path — same shape as the container images). The launcher
# runs gnome-shell + a curated gsd set in the foreground, so this unit tracks
# the Shell and Restart=always brings it back if it exits.
exec dbus-run-session -- /usr/local/bin/gnome-session-launch.sh
