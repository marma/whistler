# System-wide desktop defaults, compiled into gschemas.compiled by the bake
# (glib-compile-schemas --strict after artifacts.tar.gz lands). Every section
# exists because the session is plain user-mode gnome-shell with
# XDG_CURRENT_DESKTOP=GNOME (whistler-desktop@.service): no session mode
# enables Ubuntu Dock for us, and the dock package's own defaults
# (10_ubuntu-dock.gschema.override) — like Ubuntu's wallpaper defaults in
# 10_ubuntu-settings.gschema.override — are all `:ubuntu`-qualified so they
# never apply here; look, dock and background all have to be unqualified
# overrides. These are defaults, not locks: per-user dconf (a user toggling
# things in Settings / Extensions) still wins, and survives in the SMB home
# across sessions.

[org.gnome.shell]
enabled-extensions=['ubuntu-dock@ubuntu.com']
favorite-apps=['google-chrome.desktop', 'firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.TextEditor.desktop']

# The Ubuntu-look subset of Ubuntu's qualified defaults: dock on the left,
# always visible, full height. disable-overview-on-startup matters more here
# than on a real desktop: the Shell starts before the client has driven the
# display to its real size, and the GNOME 46/X11 overview backdrop never grows
# after a resize (see gnome-session-launch.sh) — landing on the desktop instead
# of the overview sidesteps the ugliest first impression of that limitation.
[org.gnome.shell.extensions.dash-to-dock]
dock-position='LEFT'
dock-fixed=true
extend-height=true
disable-overview-on-startup=true

# Ubuntu's default wallpaper, copied verbatim from the `:ubuntu`-qualified
# stanza in 10_ubuntu-settings.gschema.override (ubuntu-settings is not even
# installed here — the file names are, deliberately, the release-independent
# aliases `ubuntu-wallpapers` has shipped for years, so a base-image bump moves
# the picture without touching this file). Both light and dark are set because
# which one applies follows org.gnome.desktop.interface color-scheme, and a
# user flipping that in Settings must not land on the stock Adwaita default.
# Without the override the session shows GNOME's upstream Adwaita background —
# the bake asserts both files exist, since an override pointing at a missing
# file yields a *black* desktop and glib-compile-schemas cannot catch that.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/warty-final-ubuntu.png'
picture-uri-dark='file:///usr/share/backgrounds/ubuntu-wallpaper-d.png'

# Lock screen, same picture (Ubuntu sets this one light-only — the screensaver
# schema has no picture-uri-dark).
[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/warty-final-ubuntu.png'

# Ubuntu's icon set (yaru-theme-icon), for the same reason as everything above:
# Ubuntu's own default is `:ubuntu`-qualified, so without this stanza the
# session — dock included — draws upstream Adwaita icons. The value is a theme
# *directory name* under /usr/share/icons and nothing validates it: a
# misspelling or an uninstalled theme just falls back to Adwaita, silently, so
# the bake test -d's it alongside the wallpapers.
#
# Not set: cursor-theme. Yaru's cursors ride along in the same package, but
# Adwaita's are what this session has always drawn; switching them is a
# separate call. Kept in step with the pod sibling
# desktops/gnome-plain/90_whistler-desktop.gschema.override.
[org.gnome.desktop.interface]
icon-theme='Yaru'
