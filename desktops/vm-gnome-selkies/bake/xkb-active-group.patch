+# XKB has at most four groups. A key declaring fewer still answers in the
+# others: its group-info byte says how an out-of-range group is brought back
+# into range (wrap by default, clamp, or redirect to one group).
+XKB_NUM_GROUPS = 4
+XKB_OUT_OF_RANGE_MASK = 0xC0
+XKB_CLAMP_INTO_RANGE = 0x40
+XKB_REDIRECT_INTO_RANGE = 0x80
+
+
+def _effective_group(group: int, ngroups: int, group_info: int) -> int:
+    """The group a key with `ngroups` groups uses when `group` is active."""
+    if group < ngroups:
+        return group
+    action = group_info & XKB_OUT_OF_RANGE_MASK
+    if action == XKB_CLAMP_INTO_RANGE:
+        return ngroups - 1
+    if action == XKB_REDIRECT_INTO_RANGE:
+        target = (group_info >> 4) & 0x03
+        return target if target < ngroups else 0
+    return group % ngroups
 
 
