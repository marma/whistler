# macOS client keyboard fixes (apply to Selkies 2.0.0,
# 3ec56fb1538cf077c27156f5ab75b6595a83c461; re-derive when bumping the pin).
# Re-ported from the pre-2.0 patch (5686f6c4): 2.0 kept the Cmd->Ctrl swap
# unchanged and moved the modifier heal into _releaseDesyncedModifiers, which
# still releases the swapped Ctrl. 2.0 also added Input.macCmdAsCtrl (the
# dashboard's "Command as Control" switch); both fixes are gated on it, so a
# user who sends Command as Super gets upstream behaviour untouched.
#
# Fix 1 — repeated Cmd chords. Upstream's Cmd->Ctrl swap only fires while
# MetaLeft/MetaRight is still in _keyDownList, but the first swap removes it —
# and macOS reports ctrlKey=false on Cmd-chord key events, so the modifier heal
# then releases the virtual ControlLeft. Net effect on a real Mac: the FIRST
# Cmd chord per Cmd hold works, every following one (Cmd-A then Cmd-C, double
# Cmd-V) sends the letter bare and types it. Two changes, both gated on
# _macCmdSwapped so non-Mac paths are untouched: the heal keeps the swapped
# virtual ControlLeft alive while Cmd is physically held, and the swap branch
# also fires when _macCmdSwapped is already set, re-pressing Ctrl only if it
# is not already held.
#
# Fix 2 — app-aware copy/paste. Plain Cmd-C/Cmd-V are sent as dedicated
# XF86Copy/XF86Paste taps instead of the Ctrl swap, because Ctrl+C is SIGINT in
# a terminal (copy there is Ctrl+Shift+C, and Shift+Insert pastes PRIMARY, not
# CLIPBOARD). The in-session whistler-copy-agent grabs the XF86 keys and
# re-injects the chord the focused window expects — Mac-native semantics:
# Cmd-C copies everywhere, physical Ctrl-C still interrupts. Cmd-Shift-C/V and
# all other Cmd chords keep the Ctrl swap. Outside Chrome, Cmd-V's event is
# not stopped, matching 2.0's own allowNativePaste: there the browser's paste
# event is what carries the local clipboard into the session.
#
# The pre-2.0 version was verified against a live session with a
# MacIntel-spoofed Chromium driving the real client bundle; re-verify this one
# the same way (design/keyboards.md).
--- a/addons/selkies-web-core/lib/input.js
+++ b/addons/selkies-web-core/lib/input.js
@@ -1834,6 +1834,12 @@
             const byKeysym = MODIFIER_STATE_BY_KEYSYM[keysym];
             if (!byCode && !byKeysym) continue;
             if (_modifierStateHeld(event, byCode) || _modifierStateHeld(event, byKeysym)) continue;
+            // macOS Cmd->Ctrl swap: the virtual ControlLeft stands in for a
+            // physically held Cmd, whose key events report ctrlKey=false.
+            // Healing it away strips Ctrl from every chord after the first
+            // while Cmd stays held (Cmd-A then Cmd-C typed a 'c' over the
+            // selection). Keep it while the swap is active and Cmd is down.
+            if (this._macCmdSwapped && code === 'ControlLeft' && event.metaKey) continue;
             this._sendKeyEvent(keysym, code, false);
             delete this._keyDownList[code];
         }
@@ -2004,9 +2010,30 @@
             return;
         }
 
+        if (browser.isMac() && Input.macCmdAsCtrl && _isPhysicalKey(event) &&
+            (code === "KeyC" || code === "KeyV") &&
+            event.metaKey && !event.ctrlKey && !event.altKey && !event.shiftKey) {
+            // Plain Cmd-C / Cmd-V: no single X chord means "copy" in every app
+            // (GUI wants Ctrl+C/V; a terminal treats Ctrl+C as SIGINT and copies
+            // on Ctrl+Shift+C -- and Shift+Insert pastes PRIMARY, not CLIPBOARD).
+            // Send dedicated XF86Copy/XF86Paste taps instead and let the
+            // in-session whistler-copy-agent, which can see the focused window,
+            // re-inject the chord that app expects. Cmd-Shift-C/V and every
+            // other Cmd chord keep the Ctrl swap below.
+            this._sendMomentaryKey(code === "KeyC" ? KeyTable.XF86XK_Copy : KeyTable.XF86XK_Paste);
+            // As below: outside Chrome the browser's own paste event is what
+            // carries the local clipboard into the session, so let it fire.
+            const allowNativePaste = !browser.isChrome() && code === 'KeyV' && !this.isComposing;
+            if (!allowNativePaste) _stopEvent(event);
+            return;
+        }
+
         if (browser.isMac() && Input.macCmdAsCtrl && _isPhysicalKey(event) && code !== "MetaLeft" &&
             code !== "MetaRight" && event.metaKey && !event.ctrlKey && !event.altKey) {
-            if (this._keyDownList["MetaLeft"] || this._keyDownList["MetaRight"]) {
+            // _macCmdSwapped covers follow-up chords: the first swap released Meta
+            // from _keyDownList, so the Meta-in-list test alone fired only once per
+            // Cmd hold and the second chord's letter went in bare.
+            if (this._keyDownList["MetaLeft"] || this._keyDownList["MetaRight"] || this._macCmdSwapped) {
                 console.log(`macOS: Cmd+key detected for code '${code}'. Remapping Cmd to Ctrl.`);
                 if (this._keyDownList["MetaLeft"]) {
                     this._sendKeyEvent(this._keyDownList["MetaLeft"], "MetaLeft", false);
@@ -2014,7 +2041,9 @@
                 if (this._keyDownList["MetaRight"]) {
                     this._sendKeyEvent(this._keyDownList["MetaRight"], "MetaRight", false);
                 }
-                this._sendKeyEvent(KeyTable.XK_Control_L, "ControlLeft", true);
+                if (!("ControlLeft" in this._keyDownList)) {
+                    this._sendKeyEvent(KeyTable.XK_Control_L, "ControlLeft", true);
+                }
                 this._macCmdSwapped = true;
             }
         }
